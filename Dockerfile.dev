# Keep these versions aligned with .github/workflows/ci.yml.
ARG GO_VERSION=1.25.6
FROM golang:${GO_VERSION}-bookworm@sha256:f4490d7b261d73af4543c46ac6597d7d101b6e1755bcdd8c5159fda7046b6b3e
ARG HUGO_VERSION=0.167.0
ARG TARGETARCH
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    case "${TARGETARCH}" in amd64|arm64) arch="${TARGETARCH}" ;; *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; esac; \
    archive="hugo_extended_${HUGO_VERSION}_linux-${arch}.tar.gz"; \
    release="https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}"; \
    mkdir /tmp/hugo; cd /tmp/hugo; \
    curl -fsSL "${release}/${archive}" -o "$archive"; \
    curl -fsSL "${release}/hugo_${HUGO_VERSION}_checksums.txt" -o checksums.txt; \
    awk -v file="$archive" '$2 == file { print; found=1 } END { if (!found) exit 1 }' checksums.txt > selected-checksum.txt; \
    sha256sum -c selected-checksum.txt; \
    tar -xzf "$archive" -C /usr/local/bin hugo; \
    rm -rf /tmp/hugo; \
    hugo version | grep '+extended'
ENV HUGO_CACHEDIR=/cache/hugo \
    HUGO_RESOURCEDIR=/cache/resources \
    GOMODCACHE=/cache/go-mod \
    GOCACHE=/cache/go-build
WORKDIR /site
ENTRYPOINT ["hugo"]
